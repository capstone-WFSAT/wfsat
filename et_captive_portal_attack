	while true; do
		((different_mac_digit=(orig_digit + 1 + RANDOM % 15) % 16))
		[[ "${different_mac_digit}" -ne "${orig_digit}" ]] && break
	done
	printf %s%X%s\\n "${1::10}" "${different_mac_digit}" "${1:11}"
}

