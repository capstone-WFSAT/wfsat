								dos_pursuit_mode_ignored_channel="${dos_pm_current_channel}"
							fi
							continue
						fi

						dos_pursuit_mode_ignored_channel=""
						channel="${dos_pm_current_channel}"
						rm -rf "${tmpdir}${channelfile}" > /dev/null 2>&1
